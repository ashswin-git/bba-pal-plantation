# Copy this file to .env (or paste the values into Vercel → Settings → Environment Variables).
# These are public keys — no secret key is needed. The edit password is checked inside the database.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Same two values again, for the server side of the build.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Client-side /edit unlock. Set this on Vercel; do not commit the real value.
VITE_EDIT_PASSWORD=
